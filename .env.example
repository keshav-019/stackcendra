# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
# See docs/wiki/External-Platform-Setup.md for exactly how to obtain each value.

# --- GitHub OAuth App ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Google OAuth Client ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- GitHub Integration OAuth App (separate from sign-in; repo-scoped) ---
GITHUB_INTEGRATION_CLIENT_ID=
GITHUB_INTEGRATION_CLIENT_SECRET=

# --- GitLab Integration OAuth App (project access; read_user + read_api scope) ---
GITLAB_INTEGRATION_CLIENT_ID=
GITLAB_INTEGRATION_CLIENT_SECRET=

# --- Integration token encryption (AES-256-GCM key, distinct from AUTH_SECRET) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# --- Cloudflare R2 ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=

# --- PostgreSQL ---
# Production: database `stackcendra` on the VM's `pg` container (TLS only).
# On the VM itself deploy/docker-compose.yaml builds DATABASE_URL; elsewhere use
# postgres://stackcendra:<password>@vanisher.projectyourown.com:5432/stackcendra
# and put the PEM text of the VM's Postgres CA in DATABASE_CA_CERT (leave
# sslmode out of the URL when DATABASE_CA_CERT is set; see src/lib/db.ts).
DATABASE_URL=
DATABASE_CA_CERT=

# --- Gemini (bring-your-own-key) ---
GEMINI_API_KEY=

# --- Auth.js ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:8080
